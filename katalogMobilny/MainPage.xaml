<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="katalogMobilny.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Katalog produktów"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="LiczbaProduktow"
                Text="Liczba produktów: 5" />

            <Label
                x:Name="WartoscMagazynu"
                Text="Wartość magazynu: 500,00 zł" />


            <Label
                Text="Dodaj nowy produkt"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                x:Name="NazwaProduktu"
                Placeholder="Nazwa produktu"
                TextChanged="NazwaProduktu_TextChanged" />

            <Label
                x:Name="LiczbaZnakow"
                Text="Liczba znaków: 0" />

            <Entry
                x:Name="IloscProduktu"
                Placeholder="Ilość produktu"
                Keyboard="Numeric" />

            <Entry
                x:Name="CenaProduktu"
                Placeholder="Cena produktu (zł)"
                Keyboard="Numeric" />

            <Label Text="Wybierz kategorię:" />

            <Label Text="Wybierz kategorię:" />

            <Picker
    x:Name="KategoriaProduktu"
    Title="Wybierz kategorię">

                <Picker.Items>
                    <x:String>Procesory</x:String>
                    <x:String>Karty graficzne</x:String>
                    <x:String>Pamięć RAM</x:String>
                    <x:String>Dyski SSD</x:String>
                    <x:String>Dyski HDD</x:String>
                    <x:String>Płyty główne</x:String>
                    <x:String>Zasilacze</x:String>
                    <x:String>Obudowy</x:String>
                    <x:String>Chłodzenie</x:String>
                    <x:String>Monitory</x:String>
                    <x:String>Klawiatury</x:String>
                    <x:String>Myszki</x:String>
                </Picker.Items>

            </Picker>
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Text="Dodaj produkt"
                    Clicked="DodajProdukt_Click" />

                <Button
                    Grid.Column="1"
                    Text="Resetuj"
                    Clicked="ResetClicked"
                    BackgroundColor="Red"
                    TextColor="White" />

            </Grid>


            <Label
                Text="Lista dodanych produktów"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                x:Name="ListaProduktow"
                Text="Brak dodanych produktów" />

            <BoxView HeightRequest="2" Color="Gray" />


            <Label
                Text="Procesor"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#008BFF"
                HorizontalOptions="Center" />

            <Image
                Source="mikiprent.jpg"
                HeightRequest="150"
                Aspect="AspectFit" />

            <Label
                Text="Cena: 2000 zł"
                TextColor="Gray" />

            <Label
                x:Name="EtykietaWyniku"
                Text="Nic nie wybrano" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Text="Pokaż"
                    Clicked="PokazClicked" />

                <Button
                    Grid.Column="1"
                    Text="Ukryj"
                    Clicked="UkryjClicked" />

            </Grid>

            <BoxView HeightRequest="2" Color="Gray" />


            <Label
                Text="Robot"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Image
                x:Name="mikiprent"
                Source="lazerdim.jpg"
                HeightRequest="150"
                Aspect="AspectFit"
                SemanticProperties.Description="Robot" />

            <Label
                Text="Typ robota: afroamerykanin"
                TextColor="Gray" />

            <Label
                Text="Liczba IQ: 54"
                TextColor="Gray" />

            <Label
                Text="Pobór kasy: 12 zł/s"
                TextColor="Gray" />

            <Label
                Text="Cena: 2000 zł"
                TextColor="Gray" />

            <BoxView HeightRequest="2" Color="Gray" />


            <Label
                Text="Licznik kliknięć"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="CounterLabel"
                Text="Kliknięto 0 razy"
                FontSize="22"
                HorizontalOptions="Center" />

            <Button
                Text="Dodaj kliknięcie"
                Clicked="OnCounterClicked"
                BackgroundColor="Red"
                TextColor="White" />

            <Button
                Text="Resetuj licznik"
                Clicked="ResetLicznikClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
