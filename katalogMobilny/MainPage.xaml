<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="katalogMobilny.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Katalog produktów"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="LiczbaProduktow"
                Text="Liczba produktów: 5" />

            <Label
                x:Name="WartoscMagazynu"
                Text="Wartość magazynu: 500,00 zł" />

            <Label
                Text="Dodaj nowy produkt"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                x:Name="NazwaProduktu"
                Placeholder="Nazwa produktu"
                TextChanged="NazwaProduktu_TextChanged" />

            <Label
                x:Name="LiczbaZnakow"
                Text="Liczba znaków: 0" />

            <Entry
                x:Name="IloscProduktu"
                Placeholder="Ilość produktu"
                Keyboard="Numeric" />

            <Entry
                x:Name="CenaProduktu"
                Placeholder="Cena produktu (zł)"
                Keyboard="Numeric" />

            <Label Text="Wybierz kategorię:" />

            <Picker
                x:Name="KategoriaProduktu"
                Title="Wybierz kategorię">

                <Picker.Items>
                    <x:String>Procesory</x:String>
                    <x:String>Karty graficzne</x:String>
                    <x:String>Pamięć RAM</x:String>
                    <x:String>Dyski SSD</x:String>
                    <x:String>Dyski HDD</x:String>
                    <x:String>Płyty główne</x:String>
                    <x:String>Zasilacze</x:String>
                    <x:String>Obudowy</x:String>
                    <x:String>Chłodzenie</x:String>
                    <x:String>Monitory</x:String>
                    <x:String>Klawiatury</x:String>
                    <x:String>Myszki</x:String>
                </Picker.Items>

            </Picker>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Text="Dodaj produkt"
                    HeightRequest="50"
                    Clicked="DodajProdukt_Click" />

                <Button
                    Grid.Column="1"
                    Text="Resetuj"
                    HeightRequest="50"
                    Clicked="ResetClicked"
                    BackgroundColor="Red"
                    TextColor="White" />

            </Grid>

            <Label
                Text="Lista dodanych produktów"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                x:Name="ListaProduktow"
                Text="Brak dodanych produktów" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
